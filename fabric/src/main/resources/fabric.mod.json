{
  "schemaVersion": 1,
  "id": "undertale_death_screen",
  "version": "${version}",
  "name": "Undertale Death Screen",
  "description": "Brings the Undertale Death Screen to Minecraft",
  "authors": [
    "Denmoth"
  ],
  "contact": {
    "homepage": "https://github.com/Denmoth/undertale-death-screen-continued",
    "issues": "https://github.com/Denmoth/undertale-death-screen-continued/issues",
    "sources": "https://github.com/Denmoth/undertale-death-screen-continued"
  },
  "license": "MIT",
  "icon": "icon.png",
  "environment": "client",
  "entrypoints": {
    "main": [
      "com.denmoth.undertale_death_screen.fabric.UndertaleDeathScreenFabric"
    ],
    "client": [
      "com.denmoth.undertale_death_screen.fabric.client.UndertaleDeathScreenClientFabric"
    ],
    "modmenu": [
      "com.denmoth.undertale_death_screen.fabric.compat.ModMenuCompat"
    ]
  },
  "mixins": [
    "undertale_death_screen-common.mixins.json"
  ],
  "depends": {
    "fabricloader": "*",
    "fabric-api": "*",
    "minecraft": ">=26.2 <26.3"
  },
  "suggests": {
    "cloth-config": "*",
    "modmenu": "*"
  }
}
